# Copie para .env (não versionado). PINs da equipe: 4 dígitos (operador) e 6 dígitos (gestor).
PIN_OPERADOR=0000
PIN_GESTOR=000000
PIN_TRIAGEM=0000
PIN_PORTA=0000
# Porta e interface do `next start` (pm2). HOST=0.0.0.0 para acesso direto pela rede local, sem nginx.
PORT=3015
HOST=127.0.0.1
# Prefixo das URLs (vazio = raiz). Precisa coincidir com o location do nginx.
BASE_PATH=/tce-senhas
# Hosts extras aceitos pelas server actions quando o acesso é por IP/nome local (ex.: 192.168.0.10:3015).
ALLOWED_ORIGINS=
# Banco SQLite (padrão: apps/senhas/data/senhas.db) e pasta dos backups (padrão: apps/senhas/backups).
# DB_PATH=
# BACKUP_DIR=
# Token do coletor de inscritos (POST /api/inscritos). Gere com: openssl rand -hex 16
INSCRITOS_TOKEN=
# Coletor Node (só dentro da rede do TCE): URL do painel da ESCON com a chave, destino e intervalo
# URL da API pública do painel (JSON, de preferência) ou da página do painel, com a chave ?k=
# PANEL_URL=https://servicos.tce.ap.gov.br/escon/admin/api/public/painel/oiapoque?k=...
# API_URL=https://dev.gerenciahub.com.br/tce-senhas/api/inscritos
# INTERVAL_MIN=30
